/*
 * A/B boot for RAUC, built into U-Boot's default environment.
 *
 * Replaces boot.scr in the bootfs partition: this logic is part of U-Boot,
 * so TF-A verifies it together with U-Boot in the FIP. Only BOOT_ORDER,
 * BOOT_A_LEFT and BOOT_B_LEFT are read from the environment partition
 * (CONFIG_ENV_WRITEABLE_LIST, see the patch to stm32mp25_st_common.h).
 *
 * Slot A = partition "rootfs1", slot B = partition "rootfs2" on the boot
 * device. RAUC changes the BOOT_* variables from Linux with fw_setenv;
 * rauc-mark-good resets the counter after a successful boot.
 *
 * Format: doc/usage/environment.rst. Lines of a variable are joined with
 * spaces, so every command ends with ";". The file goes through the C
 * preprocessor: use C comments only.
 */

rauc_boot=
	if test "${boot_device}" != mmc; then
		/* USB/serial (STM32CubeProgrammer) and other boot media: ST default */
		run bootcmd_stm32mp;
	else
		/*
		 * No "run env_check" (ST's bootcmd_stm32mp saves the environment
		 * when it is the default one): with the writeable list it saved on
		 * every boot (seen on the board), an extra write to the SD card
		 * each time. rauc_select saves the environment anyway.
		 */
		run rauc_select;
		run rauc_load;
	fi

rauc_select=
	test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B";
	test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3;
	test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3;
	setenv rootpartname;
	for BOOT_SLOT in "${BOOT_ORDER}"; do
		if test -z "${rootpartname}"; then
			if test "x${BOOT_SLOT}" = "xA"; then
				if test ${BOOT_A_LEFT} -gt 0; then
					setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1;
					setenv rootpartname rootfs1;
					setenv raucslot A;
				fi;
			elif test "x${BOOT_SLOT}" = "xB"; then
				if test ${BOOT_B_LEFT} -gt 0; then
					setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1;
					setenv rootpartname rootfs2;
					setenv raucslot B;
				fi;
			fi;
		fi;
	done;
	if test -z "${rootpartname}"; then
		echo "No slot with attempts left, resetting counters";
		setenv BOOT_A_LEFT 3;
		setenv BOOT_B_LEFT 3;
		saveenv;
		reset;
	fi;
	echo "Booting slot ${raucslot} (${rootpartname}), attempts left: A=${BOOT_A_LEFT} B=${BOOT_B_LEFT}";
	saveenv

/* The FIT holds kernel + device tree; bootm checks its signature */
rauc_load=
	part number mmc ${boot_instance} ${rootpartname} rootpart;
	part uuid mmc ${boot_instance}:${rootpart} rootuuid;
	setenv bootargs "root=PARTUUID=${rootuuid} rootwait rw earlycon console=${console},${baudrate} rauc.slot=${raucslot}";
	if load mmc ${boot_instance}:${rootpart} ${kernel_addr_r} /boot/fitImage; then
		bootm ${kernel_addr_r};
	fi;
	echo "Booting slot ${raucslot} failed, resetting";
	sleep 3;
	reset
