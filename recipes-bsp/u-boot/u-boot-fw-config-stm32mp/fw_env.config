# U-Boot environment on the SD card, partition 7 "u-boot-env".
# Not /dev/mmcblkN: the kernel numbers the SD card, the eMMC and the SDIO
# WiFi controller in probe order, which changes between boots.
# Not /dev/disk/by-partlabel: the on-board eMMC has a partition with the
# same name. by-path is based on the SD controller's address (SDMMC1).
# U-Boot keeps a redundant environment in the last 16 KiB of the partition.
# Device                                                         Offset    Size
/dev/disk/by-path/platform-42080000.bus-amba-48220000.mmc-part7  0x7E000   0x2000
/dev/disk/by-path/platform-42080000.bus-amba-48220000.mmc-part7  0x7C000   0x2000
